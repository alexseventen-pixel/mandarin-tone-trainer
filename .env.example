# toneperfect — use the TonePerfect cloud API
# local       — send recordings to your own local HTTP model
AI_PROVIDER=toneperfect

# Required when AI_PROVIDER=toneperfect
TONEPERFECT_API_KEY=replace_with_your_key

# Required when AI_PROVIDER=local
LOCAL_AI_URL=http://127.0.0.1:8000/assess

PORT=3000
